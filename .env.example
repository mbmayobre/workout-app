# Copy this file to `.env.local` and fill in the value to turn on cloud sync.
# Without it the app still works fully, but data stays on the one device.
#
# Get the URL by running `npx dexie-cloud create` (see docs/DEPLOYMENT.md).
# It looks like: https://abc123xyz.dexie.cloud
#
# This URL is not a secret: it ships inside the built app. Access to your data
# is protected by the email sign-in, not by hiding this value.
VITE_DEXIE_CLOUD_URL=
